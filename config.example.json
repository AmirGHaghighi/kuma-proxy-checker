{
  "default_test_url": "http://httpbin.org/get",
  "expected_status": 200,
  "retries": 3,
  "timeout_seconds": 10.0,
  "retry_delay_seconds": 1.0,
  "interval_minutes": 5,
  "notifier_timeout_seconds": 10.0,
  "targets": [
    {
      "proxy": "http://user:pass@proxy1.example.com:8080",
      "push_url": "https://kuma.example.com/api/push/abc123",
      "remark": "datacenter-1"
    },
    {
      "proxy": "socks5://proxy2.example.com:1080",
      "push_url": "https://kuma.example.com/api/push/def456",
      "remark": "home-vpn",
      "test_url": "https://www.gstatic.com/generate_204"
    }
  ],
  "health_check": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 8080,
    "path": "/health",
    "response_code": 200,
    "response_json": {
      "status": "ok",
      "service": "proxy-monitor",
      "version": "{version}",
      "uptime_seconds": "{uptime_seconds}",
      "checked_at": "{timestamp}",
      "instance": "{hostname}:{pid}"
    },
    "ssl_enabled": false,
    "ssl_certfile": null,
    "ssl_keyfile": null
  }
}